! Waveform utilities

! MS_DEN is the number of milliseconds per second (1000).
int MS_DEN = 0d1000

! Clamp audio-like values into a safe, conventional percent range [-100, 100].
int AUDIO_MAX = 0d100

func int AUDIO_CLAMP(int v){
    if(gt(v, AUDIO_MAX)){ return(AUDIO_MAX) }
    if(lt(v, neg(AUDIO_MAX))){ return(neg(AUDIO_MAX)) }
    return(v)
}

func tensor SQUARE(int freq, int ms, int amp, int sr){
    assert(gt(freq, 0d0))
    assert(gt(ms, 0d0))
    assert(gt(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    del("shape")
    int period = cdiv(sr, freq)
    if(lte(period, 0d0)){ return(out) }
    int half = /(period, 0d2)
    parfor(idx, frames){
        int pos = mod(-(idx, 0d1), period)
        int v = amp
        if(gte(pos, half)){ v = neg(amp) }
        out[idx] = AUDIO_CLAMP(v)
    }
    del("frames")
    del("period")
    del("half")
    del("pos")
    del("v")
    return(out)
}

func tensor SAWTOOTH(int freq, int ms, int amp, int sr){
    assert(gt(freq, 0d0))
    assert(gt(ms, 0d0))
    assert(gt(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    del("shape")
    int period = cdiv(sr, freq)
    if(lte(period, 0d0)){ return(out) }
    parfor(idx, frames){
        int pos = mod(-(idx, 0d1), period)
        int num = *(*(*(pos, 0d4), amp), 0d1)
        int tmp = /(num, period)
        int v = -(tmp, amp)
        out[idx] = AUDIO_CLAMP(v)
    }
    del("frames")
    del("period")
    del("pos")
    del("num")
    del("tmp")
    del("v")
    return(out)
}

func tensor TRIANGLE(int freq, int ms, int amp, int sr){
    assert(gt(freq, 0d0))
    assert(gt(ms, 0d0))
    assert(gt(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    del("shape")
    int period = cdiv(sr, freq)
    if(lte(period, 0d0)){ return(out) }
    int half = /(period, 0d2)
    parfor(idx, frames){
        int pos = mod(-(idx, 0d1), period)
        int v = 0d0
        if(lt(pos, half)){
            int num = *(*(*(pos, 0d4), amp), 0d1)
            int tmp = /(num, period)
            v = +(neg(amp), tmp)
        }else{
            int t = -(pos, half)
            int num = *(*(*(t, 0d4), amp), 0d1)
            int tmp = /(num, period)
            v = -(amp, tmp)
        }
        out[idx] = AUDIO_CLAMP(v)
    }
    del("frames")
    del("period")
    del("half")
    del("pos")
    del("v")
    del("num")
    del("tmp")
    del("t")
    return(out)
}

func tensor SINE(int freq, int ms, int amp, int sr){
    assert(gt(freq, 0d0))
    assert(gt(ms, 0d0))
    assert(gt(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor base = SAWTOOTH(freq, ms, amp, sr)
    tensor out = tensor(shape, 0d0)
    del("shape")
    parfor(idx, frames){
        int previ = idx
        if(gt(idx, 0d1)){ previ = -(idx, 0d1) }
        int nexti = idx
        if(lt(idx, frames)){ nexti = +(idx, 0d1) }
        int a = base[previ]
        int b = base[idx]
        int c = base[nexti]
        int sum = +(+(a, b), c)
        int v = /(sum, 0d3)
        out[idx] = AUDIO_CLAMP(v)
    }
    del("frames")
    del("previ")
    del("nexti")
    del("a")
    del("b")
    del("c")
    del("sum")
    return(out)
}

func tensor PULSE(int freq, int ms, int amp, int sr, int duty){
    assert(gt(freq, 0d0))
    assert(gt(ms, 0d0))
    assert(gt(sr, 0d0))
    assert(gte(duty, 0d0))
    assert(lte(duty, 0d100))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    del("shape")
    int period = cdiv(sr, freq)
    if(lte(period, 0d0)){ return(out) }
    int thresh = /(*(period, duty), 0d100)
    parfor(idx, frames){
        int pos = mod(-(idx, 0d1), period)
        int v = amp
        if(gte(pos, thresh)){ v = neg(amp) }
        out[idx] = AUDIO_CLAMP(v)
    }
    del("frames")
    del("period")
    del("thresh")
    del("pos")
    del("v")
    return(out)
}

! Filters

func tensor ENVELOPE_ADSR( ^
    tensor shape, ^
    int attack, ^
    int decay, ^
    int sustain, ^
    int release ^
    ){
    assert(gte(attack, 0d0))
    assert(gte(decay, 0d0))
    assert(gte(sustain, 0d0))
    assert(gte(release, 0d0))
    ! determine frames from shape tensor ([1, frames] expected)
    int slen = len_dim(shape, 0d1)
    int frames = 0
    if(eq(slen, 0d1)){
        frames = shape[0d1]
    } else {
        frames = shape[0d2]
    }
    tensor out = tensor(shape, 0d0)
    ! clamp segment lengths so they don't exceed frames
    int a = attack
    if(gt(a, frames)){ a = frames }
    int d = decay
    if(gt(+(a,d), frames)){ d = -(frames, a) }
    int r = release
    if(gt(+(+(a,d), r), frames)){ r = -(frames, +(a,d)) }
    int s_len = -(frames, +(+(a,d), r))
    parfor(idx, frames){
        int z = -(idx, 0d1)
        int v = 0d0
        if(lt(z, a)){
            ! attack: ramp 0 -> 100
            if(eq(a, 0d0)){ v = 0d4 }else{
                int num = *(idx, 0d4)
                v = /(num, a)
            }
        } else {
            int pos = -(z, a)
            if(lt(pos, d)){
                ! decay: ramp 100 -> sustain
                if(eq(d, 0d0)){ v = sustain }else{
                    int num = *(-(0d4, sustain), -(d, pos))
                    int tmp = /(num, d)
                    v = +(sustain, tmp)
                }
            }else{
                int pos2 = -(pos, d)
                if(lt(pos2, s_len)){
                    ! sustain region
                    v = sustain
                }else{
                    ! release region: ramp sustain -> 0
                    int relpos = -(pos2, s_len)
                    int relrem = -(r, relpos)
                    if(or(eq(r, 0d0), lte(relrem, 0d0))){ v = 0d0 }else{
                        int num = *(sustain, relrem)
                        v = /(num, r)
                    }
                }
            }
        }
        out[idx] = AUDIO_CLAMP(v)
    }
    del("slen")
    del("frames")
    del("a")
    del("d")
    del("r")
    del("s_len")
    return(out)
}

func tensor LOWPASS(tensor inp, int cutoff, int sr){
    assert(gt(cutoff, 0d0))
    assert(gt(sr, 0d0))
    tensor shape = shape(inp)
    int slen = len_dim(shape, 0d1)
    int frames = 0
    if(eq(slen, 0d1)){frames = shape[0d1] }else{ frames = shape[0d2]}
    tensor out = tensor(shape, 0d0)
    int period = cdiv(sr, cutoff)
    if(lte(period, 0d0)){ return(out) }
    parfor(idx, frames){
        int z = -(idx, 0d1)
        ! compute window start
        int start = -(z, -(period, 0d1))
        if(lt(start, 0d0)){ start = 0d0 }
        int j = start
        int sum = 0d0
        while(lte(j, z)){
            int sample = inp[+(j, 0d1)]
            sum = +(sum, sample)
            j = +(j, 0d1)
        }
        int count = -( +(z, 0d1), start )
        int avg = 0d0
        if(gte(count, 0d1)){ avg = /(sum, count) }
        out[idx] = AUDIO_CLAMP(avg)
    }
    del("slen")
    del("frames")
    del("period")
    del("start")
    del("j")
    del("sum")
    del("count")
    del("avg")
    return(out)
}

func tensor HIGHPASS(tensor inp, int cutoff, int sr){
    ! highpass = original - lowpass
    tensor low = LOWPASS(inp, cutoff, sr)
    tensor shape = shape(inp)
    tensor out = tensor(shape, 0d0)
    int slen = len_dim(shape, 0d1)
    int frames = 0d0
    if(eq(slen, 0d1)){frames = shape[0d1]} else {frames = shape[0d2]}
    parfor(idx, frames){
        int i1 = idx
        int a = inp[i1]
        int b = low[i1]
        out[i1] = AUDIO_CLAMP(-(a, b))
    }
    del("slen")
    del("frames")
    del("low")
    return(out)
}
