! Waveform utilities

! MS_DEN is the number of milliseconds per second (1000).
INT MS_DEN = 0d1000

! Clamp audio-like values into a safe, conventional percent range [-100, 100].
INT AUDIO_MAX = 0d100

FUNC INT AUDIO_CLAMP(INT v){
    IF(GT(v, AUDIO_MAX)){ RETURN(AUDIO_MAX) }
    IF(LT(v, NEG(AUDIO_MAX))){ RETURN(NEG(AUDIO_MAX)) }
    RETURN(v)
}

FUNC TNS SQUARE(INT freq, INT ms, INT amp, INT sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    INT frames = /(*(sr, ms), MS_DEN)
    TNS shape = [frames]
    TNS out = TNS(shape, 0d0)
    DEL("shape")
    INT period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    INT half = /(period, 0d2)
    PARFOR(idx, frames){
        INT pos = MOD(-(idx, 0d1), period)
        INT v = amp
        IF(GTE(pos, half)){ v = NEG(amp) }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("half")
    DEL("pos")
    DEL("v")
    RETURN(out)
}

FUNC TNS SAWTOOTH(INT freq, INT ms, INT amp, INT sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    INT frames = /(*(sr, ms), MS_DEN)
    TNS shape = [frames]
    TNS out = TNS(shape, 0d0)
    DEL("shape")
    INT period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    PARFOR(idx, frames){
        INT pos = MOD(-(idx, 0d1), period)
        INT num = *(*(*(pos, 0d4), amp), 0d1)
        INT tmp = /(num, period)
        INT v = -(tmp, amp)
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("pos")
    DEL("num")
    DEL("tmp")
    DEL("v")
    RETURN(out)
}

FUNC TNS TRIANGLE(INT freq, INT ms, INT amp, INT sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    INT frames = /(*(sr, ms), MS_DEN)
    TNS shape = [frames]
    TNS out = TNS(shape, 0d0)
    DEL("shape")
    INT period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    INT half = /(period, 0d2)
    PARFOR(idx, frames){
        INT pos = MOD(-(idx, 0d1), period)
        INT v = 0d0
        IF(LT(pos, half)){
            INT num = *(*(*(pos, 0d4), amp), 0d1)
            INT tmp = /(num, period)
            v = +(NEG(amp), tmp)
        }ELSE{
            INT t = -(pos, half)
            INT num = *(*(*(t, 0d4), amp), 0d1)
            INT tmp = /(num, period)
            v = -(amp, tmp)
        }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("half")
    DEL("pos")
    DEL("v")
    DEL("num")
    DEL("tmp")
    DEL("t")
    RETURN(out)
}

FUNC TNS SINE(INT freq, INT ms, INT amp, INT sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    INT frames = /(*(sr, ms), MS_DEN)
    TNS shape = [frames]
    TNS base = SAWTOOTH(freq, ms, amp, sr)
    TNS out = TNS(shape, 0d0)
    DEL("shape")
    PARFOR(idx, frames){
        INT previ = idx
        IF(GT(idx, 0d1)){ previ = -(idx, 0d1) }
        INT nexti = idx
        IF(LT(idx, frames)){ nexti = +(idx, 0d1) }
        INT a = base[previ]
        INT b = base[idx]
        INT c = base[nexti]
        INT sum = +(+(a, b), c)
        INT v = /(sum, 0d3)
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("previ")
    DEL("nexti")
    DEL("a")
    DEL("b")
    DEL("c")
    DEL("sum")
    RETURN(out)
}

FUNC TNS PULSE(INT freq, INT ms, INT amp, INT sr, INT duty){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    ASSERT(GTE(duty, 0d0))
    ASSERT(LTE(duty, 0d100))
    INT frames = /(*(sr, ms), MS_DEN)
    TNS shape = [frames]
    TNS out = TNS(shape, 0d0)
    DEL("shape")
    INT period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    INT thresh = /(*(period, duty), 0d100)
    PARFOR(idx, frames){
        INT pos = MOD(-(idx, 0d1), period)
        INT v = amp
        IF(GTE(pos, thresh)){ v = NEG(amp) }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("thresh")
    DEL("pos")
    DEL("v")
    RETURN(out)
}

! Filters

FUNC TNS ENVELOPE_ADSR( ^
    TNS shape, ^
    INT attack, ^
    INT decay, ^
    INT sustain, ^
    INT release ^
    ){
    ASSERT(GTE(attack, 0d0))
    ASSERT(GTE(decay, 0d0))
    ASSERT(GTE(sustain, 0d0))
    ASSERT(GTE(release, 0d0))
    ! determine frames from shape tensor ([1, frames] expected)
    INT slen = TLEN(shape, 0d1)
    INT frames = 0
    IF(EQ(slen, 0d1)){
        frames = shape[0d1]
    } ELSE {
        frames = shape[0d2]
    }
    TNS out = TNS(shape, 0d0)
    ! clamp segment lengths so they don't exceed frames
    INT a = attack
    IF(GT(a, frames)){ a = frames }
    INT d = decay
    IF(GT(+(a,d), frames)){ d = -(frames, a) }
    INT r = release
    IF(GT(+(+(a,d), r), frames)){ r = -(frames, +(a,d)) }
    INT s_len = -(frames, +(+(a,d), r))
    PARFOR(idx, frames){
        INT z = -(idx, 0d1)
        INT v = 0d0
        IF(LT(z, a)){
            ! attack: ramp 0 -> 100
            IF(EQ(a, 0d0)){ v = 0d4 }ELSE{
                INT num = *(idx, 0d4)
                v = /(num, a)
            }
        } ELSE {
            INT pos = -(z, a)
            IF(LT(pos, d)){
                ! decay: ramp 100 -> sustain
                IF(EQ(d, 0d0)){ v = sustain }ELSE{
                    INT num = *(-(0d4, sustain), -(d, pos))
                    INT tmp = /(num, d)
                    v = +(sustain, tmp)
                }
            }ELSE{
                INT pos2 = -(pos, d)
                IF(LT(pos2, s_len)){
                    ! sustain region
                    v = sustain
                }ELSE{
                    ! release region: ramp sustain -> 0
                    INT relpos = -(pos2, s_len)
                    INT relrem = -(r, relpos)
                    IF(OR(EQ(r, 0d0), LTE(relrem, 0d0))){ v = 0d0 }ELSE{
                        INT num = *(sustain, relrem)
                        v = /(num, r)
                    }
                }
            }
        }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("slen")
    DEL("frames")
    DEL("a")
    DEL("d")
    DEL("r")
    DEL("s_len")
    RETURN(out)
}

FUNC TNS LOWPASS(TNS inp, INT cutoff, INT sr){
    ASSERT(GT(cutoff, 0d0))
    ASSERT(GT(sr, 0d0))
    TNS shape = SHAPE(inp)
    INT slen = TLEN(shape, 0d1)
    INT frames = 0
    IF(EQ(slen, 0d1)){frames = shape[0d1] }ELSE{ frames = shape[0d2]}
    TNS out = TNS(shape, 0d0)
    INT period = CDIV(sr, cutoff)
    IF(LTE(period, 0d0)){ RETURN(out) }
    PARFOR(idx, frames){
        INT z = -(idx, 0d1)
        ! compute window start
        INT start = -(z, -(period, 0d1))
        IF(LT(start, 0d0)){ start = 0d0 }
        INT j = start
        INT sum = 0d0
        WHILE(LTE(j, z)){
            INT sample = inp[+(j, 0d1)]
            sum = +(sum, sample)
            j = +(j, 0d1)
        }
        INT count = -( +(z, 0d1), start )
        INT avg = 0d0
        IF(GTE(count, 0d1)){ avg = /(sum, count) }
        out[idx] = AUDIO_CLAMP(avg)
    }
    DEL("slen")
    DEL("frames")
    DEL("period")
    DEL("start")
    DEL("j")
    DEL("sum")
    DEL("count")
    DEL("avg")
    RETURN(out)
}

FUNC TNS HIGHPASS(TNS inp, INT cutoff, INT sr){
    ! highpass = original - lowpass
    TNS low = LOWPASS(inp, cutoff, sr)
    TNS shape = SHAPE(inp)
    TNS out = TNS(shape, 0d0)
    INT slen = TLEN(shape, 0d1)
    INT frames = 0d0
    IF(EQ(slen, 0d1)){frames = shape[0d1]} ELSE {frames = shape[0d2]}
    PARFOR(idx, frames){
        INT i1 = idx
        INT a = inp[i1]
        INT b = low[i1]
        out[i1] = AUDIO_CLAMP(-(a, b))
    }
    DEL("slen")
    DEL("frames")
    DEL("low")
    RETURN(out)
}
