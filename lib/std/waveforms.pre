! Waveform utilities

! MS_DEN is the number of milliseconds per second (1000).
int MS_DEN = 0d1000

! Clamp audio-like values into a safe, conventional percent range [-100, 100].
int AUDIO_MAX = 0d100

func int AUDIO_CLAMP(int v){
    IF(GT(v, AUDIO_MAX)){ RETURN(AUDIO_MAX) }
    IF(LT(v, NEG(AUDIO_MAX))){ RETURN(NEG(AUDIO_MAX)) }
    RETURN(v)
}

func tensor SQUARE(int freq, int ms, int amp, int sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    DEL("shape")
    int period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    int half = /(period, 0d2)
    PARFOR(idx, frames){
        int pos = MOD(-(idx, 0d1), period)
        int v = amp
        IF(GTE(pos, half)){ v = NEG(amp) }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("half")
    DEL("pos")
    DEL("v")
    RETURN(out)
}

func tensor SAWTOOTH(int freq, int ms, int amp, int sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    DEL("shape")
    int period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    PARFOR(idx, frames){
        int pos = MOD(-(idx, 0d1), period)
        int num = *(*(*(pos, 0d4), amp), 0d1)
        int tmp = /(num, period)
        int v = -(tmp, amp)
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("pos")
    DEL("num")
    DEL("tmp")
    DEL("v")
    RETURN(out)
}

func tensor TRIANGLE(int freq, int ms, int amp, int sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    DEL("shape")
    int period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    int half = /(period, 0d2)
    PARFOR(idx, frames){
        int pos = MOD(-(idx, 0d1), period)
        int v = 0d0
        IF(LT(pos, half)){
            int num = *(*(*(pos, 0d4), amp), 0d1)
            int tmp = /(num, period)
            v = +(NEG(amp), tmp)
        }ELSE{
            int t = -(pos, half)
            int num = *(*(*(t, 0d4), amp), 0d1)
            int tmp = /(num, period)
            v = -(amp, tmp)
        }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("half")
    DEL("pos")
    DEL("v")
    DEL("num")
    DEL("tmp")
    DEL("t")
    RETURN(out)
}

func tensor SINE(int freq, int ms, int amp, int sr){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor base = SAWTOOTH(freq, ms, amp, sr)
    tensor out = tensor(shape, 0d0)
    DEL("shape")
    PARFOR(idx, frames){
        int previ = idx
        IF(GT(idx, 0d1)){ previ = -(idx, 0d1) }
        int nexti = idx
        IF(LT(idx, frames)){ nexti = +(idx, 0d1) }
        int a = base[previ]
        int b = base[idx]
        int c = base[nexti]
        int sum = +(+(a, b), c)
        int v = /(sum, 0d3)
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("previ")
    DEL("nexti")
    DEL("a")
    DEL("b")
    DEL("c")
    DEL("sum")
    RETURN(out)
}

func tensor PULSE(int freq, int ms, int amp, int sr, int duty){
    ASSERT(GT(freq, 0d0))
    ASSERT(GT(ms, 0d0))
    ASSERT(GT(sr, 0d0))
    ASSERT(GTE(duty, 0d0))
    ASSERT(LTE(duty, 0d100))
    int frames = /(*(sr, ms), MS_DEN)
    tensor shape = [frames]
    tensor out = tensor(shape, 0d0)
    DEL("shape")
    int period = CDIV(sr, freq)
    IF(LTE(period, 0d0)){ RETURN(out) }
    int thresh = /(*(period, duty), 0d100)
    PARFOR(idx, frames){
        int pos = MOD(-(idx, 0d1), period)
        int v = amp
        IF(GTE(pos, thresh)){ v = NEG(amp) }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("frames")
    DEL("period")
    DEL("thresh")
    DEL("pos")
    DEL("v")
    RETURN(out)
}

! Filters

func tensor ENVELOPE_ADSR( ^
    tensor shape, ^
    int attack, ^
    int decay, ^
    int sustain, ^
    int release ^
    ){
    ASSERT(GTE(attack, 0d0))
    ASSERT(GTE(decay, 0d0))
    ASSERT(GTE(sustain, 0d0))
    ASSERT(GTE(release, 0d0))
    ! determine frames from shape tensor ([1, frames] expected)
    int slen = TLEN(shape, 0d1)
    int frames = 0
    IF(EQ(slen, 0d1)){
        frames = shape[0d1]
    } ELSE {
        frames = shape[0d2]
    }
    tensor out = tensor(shape, 0d0)
    ! clamp segment lengths so they don't exceed frames
    int a = attack
    IF(GT(a, frames)){ a = frames }
    int d = decay
    IF(GT(+(a,d), frames)){ d = -(frames, a) }
    int r = release
    IF(GT(+(+(a,d), r), frames)){ r = -(frames, +(a,d)) }
    int s_len = -(frames, +(+(a,d), r))
    PARFOR(idx, frames){
        int z = -(idx, 0d1)
        int v = 0d0
        IF(LT(z, a)){
            ! attack: ramp 0 -> 100
            IF(EQ(a, 0d0)){ v = 0d4 }ELSE{
                int num = *(idx, 0d4)
                v = /(num, a)
            }
        } ELSE {
            int pos = -(z, a)
            IF(LT(pos, d)){
                ! decay: ramp 100 -> sustain
                IF(EQ(d, 0d0)){ v = sustain }ELSE{
                    int num = *(-(0d4, sustain), -(d, pos))
                    int tmp = /(num, d)
                    v = +(sustain, tmp)
                }
            }ELSE{
                int pos2 = -(pos, d)
                IF(LT(pos2, s_len)){
                    ! sustain region
                    v = sustain
                }ELSE{
                    ! release region: ramp sustain -> 0
                    int relpos = -(pos2, s_len)
                    int relrem = -(r, relpos)
                    IF(OR(EQ(r, 0d0), LTE(relrem, 0d0))){ v = 0d0 }ELSE{
                        int num = *(sustain, relrem)
                        v = /(num, r)
                    }
                }
            }
        }
        out[idx] = AUDIO_CLAMP(v)
    }
    DEL("slen")
    DEL("frames")
    DEL("a")
    DEL("d")
    DEL("r")
    DEL("s_len")
    RETURN(out)
}

func tensor LOWPASS(tensor inp, int cutoff, int sr){
    ASSERT(GT(cutoff, 0d0))
    ASSERT(GT(sr, 0d0))
    tensor shape = SHAPE(inp)
    int slen = TLEN(shape, 0d1)
    int frames = 0
    IF(EQ(slen, 0d1)){frames = shape[0d1] }ELSE{ frames = shape[0d2]}
    tensor out = tensor(shape, 0d0)
    int period = CDIV(sr, cutoff)
    IF(LTE(period, 0d0)){ RETURN(out) }
    PARFOR(idx, frames){
        int z = -(idx, 0d1)
        ! compute window start
        int start = -(z, -(period, 0d1))
        IF(LT(start, 0d0)){ start = 0d0 }
        int j = start
        int sum = 0d0
        WHILE(LTE(j, z)){
            int sample = inp[+(j, 0d1)]
            sum = +(sum, sample)
            j = +(j, 0d1)
        }
        int count = -( +(z, 0d1), start )
        int avg = 0d0
        IF(GTE(count, 0d1)){ avg = /(sum, count) }
        out[idx] = AUDIO_CLAMP(avg)
    }
    DEL("slen")
    DEL("frames")
    DEL("period")
    DEL("start")
    DEL("j")
    DEL("sum")
    DEL("count")
    DEL("avg")
    RETURN(out)
}

func tensor HIGHPASS(tensor inp, int cutoff, int sr){
    ! highpass = original - lowpass
    tensor low = LOWPASS(inp, cutoff, sr)
    tensor shape = SHAPE(inp)
    tensor out = tensor(shape, 0d0)
    int slen = TLEN(shape, 0d1)
    int frames = 0d0
    IF(EQ(slen, 0d1)){frames = shape[0d1]} ELSE {frames = shape[0d2]}
    PARFOR(idx, frames){
        int i1 = idx
        int a = inp[i1]
        int b = low[i1]
        out[i1] = AUDIO_CLAMP(-(a, b))
    }
    DEL("slen")
    DEL("frames")
    DEL("low")
    RETURN(out)
}
