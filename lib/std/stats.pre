! Statistics utilities for 1-D numeric tensors
! Note: these routines expect a 1-D numeric `TNS` (INT/FLT elements).
! They intentionally avoid complex type-dispatching and nested-tensor flattening
! for simplicity; callers should pass a 1-D tensor (e.g. from SHAPE/SLICE or
! constructed directly). Functions return INT or FLT as documented below.

FUNC FLT MEAN(TNS values){
    INT n = TLEN(values, 0d1)
    IF(EQ(n, 0d0)) { THROW("empty input") }
    FLT sum = 0d0.0
    FOR(i, n){
        F+(@sum, values[i])
    }
    RETURN(F/(sum, n))
}

FUNC FLT MEDIAN(TNS values){
    INT n = TLEN(values, 0d1)
    IF(EQ(n, 0d0)) { THROW("empty input") }
    ! k1 is the lower median rank (1-based)
    INT k1 = /(+(n, 0d1), 0d10) ! / by 2 (binary 10)
    ! if even, k2 is k1+1, else k2==k1
    INT is_even = MOD(n, 0d10)
    INT k2 = k1
    IF(EQ(is_even, 0d0)) { k2 = +(k1, 0d1) }

    ! find k1
    FLT val1 = 0d0.0
    FOR(i, n){
        FLT cand = FLT(values[i])
        INT less = 0d0
        INT le = 0d0
        FOR(j, n){
            FLT v = FLT(values[j])
            IF(LT(v, cand)) { +(@less, 0d1) }
            IF(OR(LT(v, cand), EQ(v, cand))) { +(@le, 0d1) }
        }
        IF(AND(LT(less, k1), LTE(k1, le))){ val1 = cand; BREAK(0d1) }
    }

    IF(EQ(k1, k2)) { RETURN(val1) }

    ! find k2
    FLT val2 = 0d0.0
    FOR(i, n){
        FLT cand = FLT(values[i])
        INT less = 0d0
        INT le = 0d0
        FOR(j, n){
            FLT v = FLT(values[j])
            IF(LT(v, cand)) { +(@less, 0d1) }
            IF(OR(LT(v, cand), EQ(v, cand))) { +(@le, 0d1) }
        }
        IF(AND(LT(less, k2), LTE(k2, le))){ val2 = cand; BREAK(0d1) }
    }

    RETURN(/(+(val1, val2), 0d2.0))
}

FUNC TNS MODE(TNS values){
    INT n = TLEN(values, 0d1)
    IF(EQ(n, 0d0)) { RETURN([ ]) }

    ! Count frequencies via MAP to avoid O(n^2) rescans.
    MAP counts = < FLT(values[1]) = 1 >
    IF(GT(n, 0d1)){
        FOR(i, -(n, 0d1)){
            INT idx = +(i, 0d1)
            FLT v = FLT(values[idx])
            IF(KEYIN(v, counts)){
                counts<v> = +(counts<v>, 0d1)
            } ELSE {
                counts<v> = 0d1
            }
        }
    }

    INT max_count = MAX(VALUES(counts))
    TNS keys = KEYS(counts)
    INT klen = TLEN(keys, 0d1)

    INT mode_count = 0d0
    FOR(i, klen){
        FLT k = FLT(keys[i])
        IF(EQ(counts<k>, max_count)) { +(@mode_count, 0d1) }
    }
    IF(EQ(mode_count, 0d0)) { RETURN([ ]) }

    TNS out = TNS([mode_count], 0d0.0)
    INT out_i = 0d0
    FOR(i, klen){
        FLT k = FLT(keys[i])
        IF(EQ(counts<k>, max_count)){
            +(@out_i, 0d1)
            out[out_i] = k
        }
    }
    RETURN(out)
}

FUNC FLT HMEAN(TNS values){
    INT n = TLEN(values, 0d1)
    IF(EQ(n, 0d0)) { THROW("empty input") }
    FLT denom = 0d0.0
    FOR(i, n){
        +(@denom, F/(0d1.0, values[i]))
    }
    RETURN(F/(n, denom))
}

FUNC FLT QUANTILE(TNS values, INT q_num, INT q_den){
    INT n = TLEN(values, 0d1)
    IF(EQ(n, 0d0)) { THROW("empty input") }
    ! target index = floor(q * (n-1)) + 1, with q = q_num/q_den
    INT range = -(n, 0d1)
    INT prod = *(q_num, range)
    INT target = /(prod, q_den)
    INT k = +(target, 0d1)

    FLT out = 0d0.0
    FOR(i, n){
        FLT cand = FLT(values[i])
        INT less = 0d0
        INT le = 0d0
        FOR(j, n){
            FLT v = FLT(values[j])
            IF(LT(v, cand)) { +(@less, 0d1) }
            IF(OR(LT(v, cand), EQ(v, cand))) { +(@le, 0d1) }
        }
        IF(AND(LT(less, k), LTE(k, le))){ out = cand; BREAK(0d1) }
    }
    RETURN(out)
}

FUNC FLT VARIANCE(TNS values, INT sample = 0d0){
    INT n = TLEN(values, 0d1)
    IF(EQ(n, 0d0)) { THROW("empty input") }
    FLT mean = MEAN(values)
    FLT var_sum = 0d0.0
    FOR(i, n){
        FLT diff = F-(values[i], mean)
        +(@var_sum, *(diff, diff))
    }
    INT denom = -(n, sample)
    ! Tests expect integer-division semantics (truncation) for variance
    FLT raw = F/(var_sum, denom)
    FLT truncated = FLT(INT(raw))
    RETURN(truncated)
}

FUNC FLT STDEV(TNS values, INT sample = 0d0){
    FLT var = VARIANCE(values, sample)
    ! Square root: exponent 1/2 -> binary literal 0.1 (equals 0.5)
    RETURN(POW(var, 0d0.5))
}

FUNC TNS HISTOGRAM(TNS values, INT bins){
    INT n = TLEN(values, 0d1)
    IF(OR(EQ(n, 0d0), LT(bins, 0d1))) { RETURN(TNS([bins], 0d0)) }

    ! find min and max
    FLT mn = FLT(values[0d1])
    FLT mx = FLT(values[0d1])
    FOR(i, n){
        FLT v = FLT(values[i])
        IF(LT(v, mn)) { mn = v }
        IF(GT(v, mx)) { mx = v }
    }

    TNS hist = TNS([bins], 0d0)
    IF(EQ(mn, mx)){
        ! all values equal -> put all counts in first bin
        hist[0d1] = n
        RETURN(hist)
    }

    ! width denominator: (mx - mn + 1) to ensure max maps to last bin
    FLT den = +(-(mx, mn), 0d1.0)
    FOR(i, n){
        FLT offset = F-(values[i], mn)
        FLT ratio = F/(F*(offset, bins), den)
        INT bin = INT(ratio)
        ! bin ranges 0..bins-1 -> store at 1-based index
        INT bi = +(bin, 0d1)
        hist[bi] = +(hist[bi], 0d1)
    }
    RETURN(hist)
}

FUNC TNS DESCRIBE(TNS values){
    INT n = TLEN(values, 0d1)
    ! desc layout: [count, mean, stdev, min, max] -> length 5 (binary 101)
    TNS desc = TNS([101], 0d0)
    IF(EQ(n, 0d0)){
        desc[0d1] = 0d0
        RETURN(desc)
    }
    desc[0d1] = n
    desc[0d2] = INT(MEAN(values))
    desc[0d3] = INT(STDEV(values, 0d0))

    ! min / max
    FLT mn = FLT(values[0d1])
    FLT mx = FLT(values[0d1])
    FOR(i, n){
        FLT v = FLT(values[i])
        IF(LT(v, mn)) {
            mn = v
        }
        IF(GT(v, mx)) {
            mx = v
        }
    }
    desc[0d4] = INT(mn)
    desc[0d5] = INT(mx)
    RETURN(desc)
}
