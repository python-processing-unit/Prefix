! Primality and factorization functions

func bool IS_PRIME(int n){
    if(lte(n, 0d1)){
        return(false)
    }
    if(eq(n, 0d2)){
        return(true)
    }
    ! reject even numbers greater than 2
    if(eq(mod(n, 0d2), 0d0)){
        return(false)
    }
    int i = 0d3
    while(lte(*(i, i), n)){
        if(eq(mod(n, i), 0d0)){
            return(false)
        }
        +(@i, 0d2)
    }
    return(true)
}

func int NEXT_PRIME(int start){
    int n = +(start, 0d1)
    while(0d1){
        if(IS_PRIME(n)){
            return(n)
        }
        +(@n, 0d1)
    }
}

func int PREV_PRIME(int start){
    int n = -(start, 0d1)
    while(gt(n, 0d1)){
        if(IS_PRIME(n)){
            return(n)
        }
        -(@n, 0d1)
    }
    return(0d0)
}

func bool IS_MERSENNE_PRIME(int p){
    if(IS_PRIME(p)){
        int exp = pow(0d2, p)
        int mersenne = -(exp, 0d1)
        if(IS_PRIME(mersenne)){
            return(true)
        }
        return(false)
    }else{
        return(false)
    }
}

func tensor FACTOR(int n){
    if(lte(n, 0d1)){
        tensor empty = [0d0]
        return(empty)
    }
    int p = 0d2
    int coll_len = 0d0
    tensor coll = [0d0]  ! placeholder, real shape tracked by coll_len
    while(lte(*(p, p), n)){
        if(eq(mod(n, p), 0d0)){
            if(eq(coll_len, 0d0)){
                tensor first = [p]
                coll = first
                coll_len = 0d1
            } else {
                int old_len = len_dim(coll, 0d1)
                int new_len = +(old_len, 0d1)
                tensor new_coll = tensor([new_len], 0d0)
                for(i, old_len){
                    new_coll[i] = coll[i]
                }
                new_coll[new_len] = p
                coll = new_coll
                coll_len = new_len
            }
            /(@n, p)
        } else {
            p = NEXT_PRIME( +(p, 0d1) )
        }
    }
    if(gt(n, 0d1)){
        if(eq(coll_len, 0d0)){
            tensor last = [n]
            coll = last
            coll_len = 0d1
        } else {
            int old_len2 = len_dim(coll, 0d1)
            int new_len2 = +(old_len2, 0d1)
            tensor new_coll2 = tensor([new_len2], 0d0)
            for(j, old_len2){
                new_coll2[j] = coll[j]
            }
            new_coll2[new_len2] = n
            coll = new_coll2
            coll_len = new_len2
        }
    }
    return(coll)
}
