! Primality and factorization functions

func bool IS_PRIME(int n){
    IF(LTE(n, 0d1)){
        RETURN(FALSE)
    }
    IF(EQ(n, 0d2)){
        RETURN(TRUE)
    }
    ! reject even numbers greater than 2
    IF(EQ(MOD(n, 0d2), 0d0)){
        RETURN(FALSE)
    }
    int i = 0d3
    WHILE(LTE(*(i, i), n)){
        IF(EQ(MOD(n, i), 0d0)){
            RETURN(FALSE)
        }
        +(@i, 0d2)
    }
    RETURN(TRUE)
}

func int NEXT_PRIME(int start){
    int n = +(start, 0d1)
    WHILE(0d1){
        IF(IS_PRIME(n)){
            RETURN(n)
        }
        +(@n, 0d1)
    }
}

func int PREV_PRIME(int start){
    int n = -(start, 0d1)
    WHILE(GT(n, 0d1)){
        IF(IS_PRIME(n)){
            RETURN(n)
        }
        -(@n, 0d1)
    }
    RETURN(0d0)
}

func bool IS_MERSENNE_PRIME(int p){
    IF(IS_PRIME(p)){
        int exp = POW(0d2, p)
        int mersenne = -(exp, 0d1)
        IF(IS_PRIME(mersenne)){
            RETURN(TRUE)
        }
        RETURN(FALSE)
    }ELSE{
        RETURN(FALSE)
    }
}

func tensor FACTOR(int n){
    IF(LTE(n, 0d1)){
        tensor empty = [0d0]
        RETURN(empty)
    }
    int p = 0d2
    int coll_len = 0d0
    tensor coll = [0d0]  ! placeholder, real shape tracked by coll_len
    WHILE(LTE(*(p, p), n)){
        IF(EQ(MOD(n, p), 0d0)){
            IF(EQ(coll_len, 0d0)){
                tensor first = [p]
                coll = first
                coll_len = 0d1
            } ELSE {
                int old_len = TLEN(coll, 0d1)
                int new_len = +(old_len, 0d1)
                tensor new_coll = tensor([new_len], 0d0)
                FOR(i, old_len){
                    new_coll[i] = coll[i]
                }
                new_coll[new_len] = p
                coll = new_coll
                coll_len = new_len
            }
            /(@n, p)
        } ELSE {
            p = NEXT_PRIME( +(p, 0d1) )
        }
    }
    IF(GT(n, 0d1)){
        IF(EQ(coll_len, 0d0)){
            tensor last = [n]
            coll = last
            coll_len = 0d1
        } ELSE {
            int old_len2 = TLEN(coll, 0d1)
            int new_len2 = +(old_len2, 0d1)
            tensor new_coll2 = tensor([new_len2], 0d0)
            FOR(j, old_len2){
                new_coll2[j] = coll[j]
            }
            new_coll2[new_len2] = n
            coll = new_coll2
            coll_len = new_len2
        }
    }
    RETURN(coll)
}
