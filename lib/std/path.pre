! Path utilities for Prefix

func str normalize_path(str path){
    return(replace(path,"\\","/"))
}

func str windows_path(str path){
    return(replace(path,"/","\\"))
}

func str directory_name(str path){ ! returns directory portion of path
    str npath = normalize_path(path)
    str base = file_name(npath)
    if(eq(base, "")){
        return("")
    }
    if(eq(npath, base)){
        return("")
    }
    str dir = replace(npath, join("/", base), "")
    pop("dir")
}

func str file_name(str path){ ! returns filename portion of path
    tensor tpath = split(normalize_path(path), "/")
    str basename = tpath[max(len_dim(tpath, 0d1), 0d1)]
    del("tpath")
    pop("basename")
}

func tensor split_extension(str path){ ! returns [name without ext, ext]
    str npath = normalize_path(path)
    str base = file_name(npath)
    str dir = directory_name(npath)
    tensor parts = split(base, ".")
    ! If there is no dot, return the path unchanged and empty ext
    if(eq(len_dim(parts, 0d1), 0d1)){
        del("base")
        tensor result = [npath, ""]
        pop("result")
    }
    ! Extension is the last segment (1-based indexing)
    str ext = parts[ len_dim(parts, 0d1) ]
    ! Name is base without the final "." + ext suffix
    str name = replace(base, join(".", ext), "")
    del("parts")
    str delex = ""
    if(eq(dir, "")){
        delex = name
    } else {
        if( or( eq(dir, npath), eq(dir, join(npath, "/")) ) ){
            delex = name
        } else {
            delex = join(dir, "/", name)
        }
    }
    del("dir")
    del("name")
    tensor result = [delex, ext]
    pop("result")
}

func str extension_name(str path){ ! returns extension portion of path
    return(split_extension(path)[0d2])
}

func str strip_extension(str path){ ! returns path without extension
    return(split_extension(path)[0d1])
}

func str temp_file(str local_path){
    if(eq(os(),"win")){
        str temp = "C:/Windows/Temp/"
    } elseif(eq(os(),"mac")){
        throw("temp_file not implemented for macOS yet")
        ! per-user temp dirs on macOS are more complex
        ! add later
    } else {
        str temp = "/tmp/"
    }
    str final_path = join(temp, local_path)
    del("temp")
    pop("final_path")
}

str interpreter = argv()[0d1]
str interpreter_dir = normalize_path(directory_name(argv()[0d1]))
if(gte(len_dim(argv(), 0d1), 0d2)){
    str script = argv()[0d2]
    str script_dir = normalize_path(directory_name(argv()[0d2]))
} else {
    str script = ""
    str script_dir = ""
}
