! Path utilities for Prefix

func str NORMALIZE_PATH(str path){
    return(replace(path,"\\","/"))
}

func str WINPATH(str path){
    return(replace(path,"/","\\"))
}

func str BASEPATH(str path){ ! returns directory portion of path
    str npath = NORMALIZE_PATH(path)
    str base = BASENAME(npath)
    if(eq(base, "")){
        return("")
    }
    str dir = replace(npath, join("/", base), "")
    del("npath")
    pop("dir")
}

func str BASENAME(str path){ ! returns filename portion of path
    tensor tpath = split(NORMALIZE_PATH(path), "/")
    str basename = tpath[max(len_dim(tpath, 0d1), 0d1)]
    del("tpath")
    pop("basename")
}

func tensor SPLITEXT(str path){ ! returns [name without ext, ext]
    str npath = NORMALIZE_PATH(path)
    str base = BASENAME(npath)
    str dir = BASEPATH(npath)
    tensor parts = split(base, ".")
    ! If there is no dot, return the path unchanged and empty ext
    if(eq(len_dim(parts, 0d1), 0d1)){
        del("base")
        tensor result = [npath, ""]
        pop("result")
    }
    ! Extension is the last segment (1-based indexing)
    str ext = parts[ len_dim(parts, 0d1) ]
    ! Name is base without the final "." + ext suffix
    str name = replace(base, join(".", ext), "")
    del("parts")
    str delex = ""
    if(eq(dir, "")){
        delex = name
    } else {
        if( or( eq(dir, npath), eq(dir, join(npath, "/")) ) ){
            delex = name
        } else {
            delex = join(dir, name)
        }
    }
    del("dir")
    del("name")
    tensor result = [delex, ext]
    pop("result")
}

func str EXTNAME(str path){ ! returns extension portion of path
    return(SPLITEXT(path)[0d2])
}

func str DELEXT(str path){ ! returns path without extension
    return(SPLITEXT(path)[0d1])
}

func str TEMPFILE(str local_path){
    if(eq(os(),"win")){
        str temp = "C:/Windows/Temp/"
    } elseif(eq(os(),"mac")){
        throw("TEMPFILE not implemented for macOS yet")
        ! per-user temp dirs on macOS are more complex
        ! add later
    } else {
        str temp = "/tmp/"
    }
    str final_path = join(temp, local_path)
    del("temp")
    pop("final_path")
}

str interpreter = argv()[0d1]
str interpreter_dir = NORMALIZE_PATH(BASEPATH(argv()[0d1]))
if(gte(len_dim(argv(), 0d1), 0d2)){
    str script = argv()[0d2]
    str script_dir = NORMALIZE_PATH(BASEPATH(argv()[0d2]))
} else {
    str script = ""
    str script_dir = ""
}
