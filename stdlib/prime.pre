! Primality and factorization functions

FUNC INT: IS_PRIME(INT: n){
    IF(LTE(n, 0d1)){
        RETURN(0d0)
    }
    IF(EQ(n, 0d2)){
        RETURN(0d1)
    }
    ! reject even numbers greater than 2
    IF(EQ(MOD(n, 0d2), 0d0)){
        RETURN(0d0)
    }
    INT: i = 0d3
    WHILE(LTE(MUL(i, i), n)){
        IF(EQ(MOD(n, i), 0d0)){
            RETURN(0d0)
        }
        ADD(@i, 0d2)
    }
    RETURN(0d1)
}

FUNC INT: NEXT_PRIME(INT: start){
    INT: n = ADD(start, 0d1)
    WHILE(0d1){
        IF(IS_PRIME(n)){
            RETURN(n)
        }
        ADD(@n, 0d1)
    }
}

FUNC INT: PREV_PRIME(INT: start){
    INT: n = SUB(start, 0d1)
    WHILE(GT(n, 0d1)){
        IF(IS_PRIME(n)){
            RETURN(n)
        }
        SUB(@n, 0d1)
    }
    RETURN(0d0)
}

FUNC INT: IS_MERSENNE_PRIME(INT: p){
    IF(IS_PRIME(p)){
        INT: exp = POW(0d2, p)
        INT: mersenne = SUB(exp, 0d1)
        IF(IS_PRIME(mersenne)){
            RETURN(0d1)
        }
        RETURN(0d0)
    }ELSE{
        RETURN(0d0)
    }
}

FUNC TNS: FACTOR(INT: n){
    IF(LTE(n, 0d1)){
        TNS: empty = [0d0]
        RETURN(empty)
    }
    INT: p = 0d2
    INT: coll_len = 0d0
    TNS: coll = [0d0]  ! placeholder, real shape tracked by coll_len
    WHILE(LTE(MUL(p, p), n)){
        IF(EQ(MOD(n, p), 0d0)){
            IF(EQ(coll_len, 0d0)){
                TNS: first = [p]
                coll = first
                coll_len = 0d1
            } ELSE {
                INT: old_len = TLEN(coll, 0d1)
                INT: new_len = ADD(old_len, 0d1)
                TNS: new_coll = TNS([new_len], 0d0)
                FOR(i, old_len){
                    new_coll[i] = coll[i]
                }
                new_coll[new_len] = p
                coll = new_coll
                coll_len = new_len
            }
            DIV(@n, p)
        } ELSE {
            p = NEXT_PRIME( ADD(p, 0d1) )
        }
    }
    IF(GT(n, 0d1)){
        IF(EQ(coll_len, 0d0)){
            TNS: last = [n]
            coll = last
            coll_len = 0d1
        } ELSE {
            INT: old_len2 = TLEN(coll, 0d1)
            INT: new_len2 = ADD(old_len2, 0d1)
            TNS: new_coll2 = TNS([new_len2], 0d0)
            FOR(j, old_len2){
                new_coll2[j] = coll[j]
            }
            new_coll2[new_len2] = n
            coll = new_coll2
            coll_len = new_len2
        }
    }
    RETURN(coll)
}
