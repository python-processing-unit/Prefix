BOOL: sample_bool_true = TRUE
INT: sample_int = -0d7
FLT: sample_flt = 0d3.5
STR: sample_str = "prefix"
TNS: sample_tns = [0d1, 0d2]
MAP: sample_map = <"n" = 0d1>

FUNC INT: sample_func(INT: value){
    RETURN(value)
}

THR(sample_thr){}

ASSERT(NOT(ISFLT(sample_bool_true)))
ASSERT(NOT(ISFLT(sample_int)))
ASSERT(ISFLT(sample_flt))
ASSERT(NOT(ISFLT(sample_str)))
ASSERT(NOT(ISFLT(sample_tns)))
ASSERT(NOT(ISFLT(sample_map)))
ASSERT(NOT(ISFLT(sample_func)))
ASSERT(NOT(ISFLT(sample_thr)))
