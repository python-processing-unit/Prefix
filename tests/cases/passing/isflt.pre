BOOL: sample_bool_true = TRUE
INT: sample_int = -0d7
FLT: sample_flt = 0d3.5
STR: sample_str = "prefix"
TNS: sample_tns = [0d1, 0d2]
MAP: sample_map = <"n" = 0d1>

FUNC INT: sample_func(INT: value){
    RETURN(value)
}

THR(sample_thr){}

REFUTE(ISFLT(sample_bool_true))
REFUTE(ISFLT(sample_int))
ASSERT(ISFLT(sample_flt))
REFUTE(ISFLT(sample_str))
REFUTE(ISFLT(sample_tns))
REFUTE(ISFLT(sample_map))
REFUTE(ISFLT(sample_func))
REFUTE(ISFLT(sample_thr))
