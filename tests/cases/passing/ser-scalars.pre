ASSERT(EQ(SER(TRUE), '{"t":"BOOL","v":true}'))
ASSERT(EQ(SER(FALSE), '{"t":"BOOL","v":false}'))

ASSERT(EQ(SER(0d42), '{"t":"INT","v":"0d42"}'))
ASSERT(EQ(SER(-0xA), '{"t":"INT","v":"-0xA"}'))

ASSERT(EQ(SER(0d3.5), '{"t":"FLT","v":"0d3.5"}'))
ASSERT(EQ(SER(-INF), '{"t":"FLT","v":"-INF"}'))
ASSERT(EQ(SER(NaN), '{"t":"FLT","v":"NaN"}'))

ASSERT(EQ(UNSER(SER(0x2A)), 0x2A))
ASSERT(EQ(STR(UNSER(SER(NaN))), "NaN"))