INT left_dec = 0d2
INT right_bin = 0b11
INT wide_hex = 0x10

ASSERT(EQ(-(right_bin, left_dec), 0d1))
ASSERT(EQ(BASE(-(right_bin, left_dec)), 0d10))

ASSERT(EQ(-(left_dec, right_bin), -0d1))
ASSERT(EQ(BASE(-(left_dec, right_bin)), 0d10))

ASSERT(EQ(-(wide_hex, left_dec), 0d14))
ASSERT(EQ(BASE(-(wide_hex, left_dec)), 0d16))