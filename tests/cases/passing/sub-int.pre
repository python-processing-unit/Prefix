INT left_dec = 0d2
INT right_bin = 0b11
INT wide_hex = 0x10

ASSERT(EQ(SUB(right_bin, left_dec), 0d1))
ASSERT(EQ(BASE(SUB(right_bin, left_dec)), 0d10))

ASSERT(EQ(SUB(left_dec, right_bin), -0d1))
ASSERT(EQ(BASE(SUB(left_dec, right_bin)), 0d10))

ASSERT(EQ(SUB(wide_hex, left_dec), 0d14))
ASSERT(EQ(BASE(SUB(wide_hex, left_dec)), 0d16))