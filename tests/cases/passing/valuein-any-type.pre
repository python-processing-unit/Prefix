MAP bool_map = <"t" = TRUE, "f" = FALSE>
MAP int_map = <"i" = 0d7>
MAP flt_map = <"p" = 0d2.5>
MAP str_map = <"s" = "text">
MAP tns_map = <"vec" = [0d1, 0d2]>

ASSERT(VALUEIN(TRUE, bool_map))
ASSERT(VALUEIN(0d7, int_map))
ASSERT(VALUEIN(0d2.5, flt_map))
ASSERT(VALUEIN("text", str_map))
ASSERT(VALUEIN([0d1, 0d2], tns_map))
REFUTE(VALUEIN([0d2, 0d1], tns_map))
