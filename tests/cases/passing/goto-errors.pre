INT errors_caught = 0d0

TRY {
    GOTOPOINT(TRUE)
} CATCH(err) {
    ASSERT(EQ(err, 'GOTOPOINT requires INT or STR argument'))
     +(@errors_caught, 0d1)
}

TRY {
    GOTO(TRUE)
} CATCH(err) {
    ASSERT(EQ(err, 'GOTO requires INT or STR argument'))
     +(@errors_caught, 0d1)
}

TRY {
    GOTOPOINT(-0d1)
} CATCH(err) {
    ASSERT(EQ(err, 'Negative GOTOPOINT identifier is not allowed'))
     +(@errors_caught, 0d1)
}

TRY {
    GOTO(-0d1)
} CATCH(err) {
    ASSERT(EQ(err, 'Negative GOTO target is not allowed'))
     +(@errors_caught, 0d1)
}

TRY {
    GOTO('unregistered')
} CATCH(err) {
    ASSERT(EQ(err, 'Unregistered GOTO target'))
     +(@errors_caught, 0d1)
}

ASSERT(EQ(errors_caught, 0d5))
