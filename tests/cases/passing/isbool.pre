BOOL: sample_bool_true = TRUE
BOOL: sample_bool_false = FALSE
INT: sample_int = -0d7
FLT: sample_flt = 0d3.5
STR: sample_str = "prefix"
TNS: sample_tns = [0d1, 0d2]
MAP: sample_map = <"n" = 0d1>

FUNC INT: sample_func(INT: value){
    RETURN(value)
}

THR(sample_thr){}

ASSERT(ISBOOL(sample_bool_true))
ASSERT(ISBOOL(sample_bool_false))
ASSERT(NOT(ISBOOL(sample_int)))
ASSERT(NOT(ISBOOL(sample_flt)))
ASSERT(NOT(ISBOOL(sample_str)))
ASSERT(NOT(ISBOOL(sample_tns)))
ASSERT(NOT(ISBOOL(sample_map)))
ASSERT(NOT(ISBOOL(sample_func)))
ASSERT(NOT(ISBOOL(sample_thr)))
