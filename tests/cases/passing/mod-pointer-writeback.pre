INT a1 = 0d5
INT b1 = 0d2
MOD(@a1, b1)
ASSERT(EQ(a1, 0d1))

INT a2 = 0d5
INT b2 = 0d2
MOD(a2, @b2)
ASSERT(EQ(b2, 0d2))

INT a3 = 0d5
INT b3 = 0d2
MOD(@a3, @b3)
ASSERT(EQ(a3, 0d1))
ASSERT(EQ(b3, 0d1))

FLT f1 = 0d5.5
FLT g1 = 0d2.0
MOD(@f1, g1)
ASSERT(EQ(f1, 0d1.5))

FLT f2 = 0d5.5
FLT g2 = 0d2.0
MOD(f2, @g2)
ASSERT(EQ(g2, 0d2.0))

FLT f3 = 0d5.5
FLT g3 = 0d2.0
MOD(@f3, @g3)
ASSERT(EQ(f3, 0d1.5))
ASSERT(EQ(g3, 0d1.5))
