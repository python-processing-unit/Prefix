FUNC INT{0d2} add(INT{0d2} a, INT{0d2} b) {
    RETURN(+(a, b))
}
ASSERT(EQ(SIGNATURE(add), "INT{0d2} add(INT{0d2} a, INT{0d2} b)"))

FUNC FLT{0d16} scale(FLT{0d16} x) {
    RETURN(*(x, 0x2.0))
}
ASSERT(EQ(SIGNATURE(scale), "FLT{0d16} scale(FLT{0d16} x)"))

INT{0d8} octal = 0o77
ASSERT(EQ(SIGNATURE(octal), "INT{0d8} octal"))

FLT{0d32} flt_named = 0t1.5
ASSERT(EQ(SIGNATURE(flt_named), "FLT{0d32} flt_named"))
