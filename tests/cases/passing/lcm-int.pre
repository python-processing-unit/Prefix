INT left_oct = 0o25
INT right_hex = 0x6
INT zero_bin = 0b0
INT co_prime_left_oct = 0o10
INT co_prime_right_dec = 0d9

ASSERT(EQ(LCM(left_oct, right_hex), 0x2A))
ASSERT(EQ(LCM(right_hex, left_oct), 0x2A))
ASSERT(ISINT(LCM(left_oct, right_hex)))
ASSERT(EQ(BASE(LCM(left_oct, right_hex)), 0d16))

ASSERT(EQ(LCM(zero_bin, right_hex), 0x0))
ASSERT(EQ(BASE(LCM(zero_bin, right_hex)), 0d16))

ASSERT(EQ(LCM(co_prime_left_oct, co_prime_right_dec), 0d72))
ASSERT(EQ(BASE(LCM(co_prime_left_oct, co_prime_right_dec)), 0d10))
