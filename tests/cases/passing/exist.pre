BOOL: outer = TRUE
BOOL: declared_only

FUNC BOOL: outer_visible(){
    RETURN(EXIST(outer))
}

FUNC BOOL: inner_visible(){
    BOOL: inner = TRUE
    RETURN(EXIST(inner))
}

FUNC BOOL: missing_visible(){
    RETURN(EXIST(missing))
}

ASSERT(EXIST(outer))
REFUTE(EXIST(declared_only))
ASSERT(outer_visible())
ASSERT(inner_visible())
REFUTE(missing_visible())

DEL(outer)
REFUTE(EXIST(outer))
REFUTE(outer_visible())
