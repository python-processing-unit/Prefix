INT exact_hex = 0x64
INT floor_dec = 0d17
INT zero_hex = 0x0
INT unit_hex = 0x1
INT root_dec = 0d2
INT root_hex = 0x2
INT neg_one_dec = -0d1

ASSERT(EQ(ROOT(exact_hex, root_dec), 0xA))
ASSERT(ISINT(ROOT(exact_hex, root_dec)))
ASSERT(EQ(BASE(ROOT(exact_hex, root_dec)), 0d16))

ASSERT(EQ(ROOT(floor_dec, root_hex), 0x4))
ASSERT(EQ(BASE(ROOT(floor_dec, root_hex)), 0d16))

ASSERT(EQ(ROOT(zero_hex, 0d5), 0x0))
ASSERT(EQ(BASE(ROOT(zero_hex, 0d5)), 0d16))
ASSERT(EQ(ROOT(unit_hex, neg_one_dec), 0x1))
ASSERT(EQ(BASE(ROOT(unit_hex, neg_one_dec)), 0d16))
