INT: a1 = 0d6
INT: b1 = 0d3
DIV(@a1, b1)
ASSERT(EQ(a1, 0d2))

INT: a2 = 0d6
INT: b2 = 0d3
DIV(a2, @b2)
ASSERT(EQ(b2, 0d3))

INT: a3 = 0d6
INT: b3 = 0d3
DIV(@a3, @b3)
ASSERT(EQ(a3, 0d2))
ASSERT(EQ(b3, 0d2))

FLT: f1 = 0d3.0
FLT: g1 = 0d1.5
DIV(@f1, g1)
ASSERT(EQ(f1, 0d2.0))

FLT: f2 = 0d3.0
FLT: g2 = 0d1.5
DIV(f2, @g2)
ASSERT(EQ(g2, 0d1.5))

FLT: f3 = 0d3.0
FLT: g3 = 0d1.5
DIV(@f3, @g3)
ASSERT(EQ(f3, 0d2.0))
ASSERT(EQ(g3, 0d2.0))
