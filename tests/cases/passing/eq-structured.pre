TNS: tensor = [[0d1, 0d2], [0d3, 0d4]]
TNS: tensor_copy = tensor

MAP: map_value = <"alpha" = 0d1, "beta" = [0d2, 0d3]>
MAP: map_copy = map_value

FUNC INT: identity(INT: value){
    RETURN(value)
}
FUNC: identity_alias = identity

THR(worker){}

ASSERT(ISBOOL(EQ(tensor_copy, tensor)))
ASSERT(EQ(tensor_copy, tensor))
ASSERT(NOT(EQ(tensor, [[0d1, 0d2], [0d3, 0d5]])))

ASSERT(EQ(map_copy, map_value))
ASSERT(NOT(EQ(map_value, <"alpha" = 0d1, "beta" = [0d2, 0d4]>)))

ASSERT(EQ(identity_alias, identity))
ASSERT(EQ(worker, worker))