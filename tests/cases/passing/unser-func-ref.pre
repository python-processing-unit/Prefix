STR loc = '\R{"file":"<unknown>","line":1,"column":1,"statement":""}'

STR full = JOIN( ^
    '\R{"t":"FUNC","id":"f1","name":"five","return":"INT","params":[],"def":{"name":"five","return":"INT","params":[],"body":{"n":"Block","loc":', ^
    loc, ^
    '\R,"statements":[{"n":"ReturnStatement","loc":', ^
    loc, ^
    '\R,"expression":{"n":"Literal","loc":', ^
    loc, ^
    '\R,"value":5,"base":10,"literal_type":"INT"}}]},"closure":null}}' ^
)

STR json = JOIN( ^
    '\R{"t":"MAP","v":[{"k":{"t":"STR","v":"first"},"v":', ^
    full, ^
    '\R},{"k":{"t":"STR","v":"second"},"v":{"t":"FUNC","id":"f1","ref":true}}]}' ^
)

MAP funcs = UNSER(json)
ASSERT(EQ(funcs<"first">, funcs<"second">))
ASSERT(EQ(funcs<"first">(), 0d5))
ASSERT(EQ(funcs<"second">(), 0d5))