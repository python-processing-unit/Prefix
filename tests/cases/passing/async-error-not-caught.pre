BOOL caught = FALSE

TRY{
    THR worker = ASYNC{
        FREEZE("not_declared")
    }
} CATCH {
    caught = TRUE
}

REFUTE(caught)


! Also ensure awaiting the failed thread does not synchronously raise
BOOL caught_await = FALSE

THR worker2 = ASYNC{
    FREEZE("not_declared")
}

TRY{
    AWAIT(worker2)
} CATCH {
    caught_await = TRUE
}

REFUTE(caught_await)
