BOOL released = FALSE

THR worker = ASYNC{
    WHILE(NOT(released)){}
}

THR paused = PAUSE(worker, seconds = 0d0.05)

ASSERT(EQ(TYPE(paused), "THR"))
ASSERT(EQ(paused, worker))
ASSERT(BOOL(worker))
ASSERT(PAUSED(worker))

released = TRUE

AWAIT(worker)

REFUTE(BOOL(worker))
REFUTE(PAUSED(worker))