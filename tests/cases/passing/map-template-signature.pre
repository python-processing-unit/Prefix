! SIGNATURE of named MAP variable
MAP{<"x" = 0d1>} var = <"x" = 0d42>
ASSERT(EQ(SIGNATURE(var), "MAP{<\"x\" = 0d1>} var"))

! SIGNATURE of plain MAP variable (no template)
MAP plain = <"y" = 0d1>
ASSERT(EQ(SIGNATURE(plain), "MAP plain"))

! SIGNATURE of empty-template MAP variable
MAP{<>} empty_tmpl = <"anything" = 0d1>
ASSERT(EQ(SIGNATURE(empty_tmpl), "MAP{<>} empty_tmpl"))

! SIGNATURE of function with MAP return template
FUNC MAP{<"ok" = TRUE>} fn_ret_tmpl() {
    RETURN(<"ok" = TRUE>)
}
ASSERT(EQ(SIGNATURE(fn_ret_tmpl), "MAP{<\"ok\" = TRUE>} fn_ret_tmpl()"))

! SIGNATURE of function with MAP param template
FUNC MAP process(MAP{<"a" = 0d1>} input) {
    RETURN(input)
}
ASSERT(EQ(SIGNATURE(process), "MAP process(MAP{<\"a\" = 0d1>} input)"))

! SIGNATURE of function with both return and param templates
FUNC MAP{<"result" = 0d1>} full_tmpl(MAP{<"key" = "val">} m) {
    RETURN(<"result" = 0d1>)
}
ASSERT(EQ(SIGNATURE(full_tmpl), "MAP{<\"result\" = 0d1>} full_tmpl(MAP{<\"key\" = \"val\">} m)"))

! SIGNATURE of function with coerced param and template
FUNC MAP full_coerce(~MAP{<"in" = 0d1>} m) {
    RETURN(m)
}
ASSERT(EQ(SIGNATURE(full_coerce), "MAP full_coerce(~MAP{<\"in\" = 0d1>} m)"))
