INT left_dec = 0d54
INT right_hex = 0x18
INT zero_bin = 0b0
INT co_prime_left_oct = 0o17
INT co_prime_right_dec = 0d13

ASSERT(EQ(GCD(left_dec, right_hex), 0x6))
ASSERT(EQ(GCD(right_hex, left_dec), 0x6))
ASSERT(ISINT(GCD(left_dec, right_hex)))
ASSERT(EQ(BASE(GCD(left_dec, right_hex)), 0d16))

ASSERT(EQ(GCD(zero_bin, right_hex), 0x18))
ASSERT(EQ(BASE(GCD(zero_bin, right_hex)), 0d16))

ASSERT(EQ(GCD(co_prime_left_oct, co_prime_right_dec), 0d1))
ASSERT(EQ(BASE(GCD(co_prime_left_oct, co_prime_right_dec)), 0d10))
