INT runtime_errors = 0d0

FUNC INT wrong_return(){
    RETURN("bad")
}

TRY{
    wrong_return()
} CATCH(err){
    runtime_errors = +(runtime_errors, 0d1)
}

FUNC TNS missing_tns_return(){}
TRY{
    missing_tns_return()
} CATCH(err){
    runtime_errors = +(runtime_errors, 0d1)
}

FUNC MAP missing_map_return(){}
TRY{
    missing_map_return()
} CATCH(err){
    runtime_errors = +(runtime_errors, 0d1)
}

FUNC FUNC missing_func_return(){}
TRY{
    missing_func_return()
} CATCH(err){
    runtime_errors = +(runtime_errors, 0d1)
}

FUNC THR missing_thr_return(){}
TRY{
    missing_thr_return()
} CATCH(err){
    runtime_errors = +(runtime_errors, 0d1)
}

FUNC missing_lambda_return = LAMBDA FUNC (){}
TRY{
    missing_lambda_return()
} CATCH(err){
    runtime_errors = +(runtime_errors, 0d1)
}

ASSERT(EQ(runtime_errors, 0d6))
