BOOL finished = FALSE

THR worker = ASYNC{
    FOR(i, 0d1000){}
    finished = TRUE
}

! Wait for worker to finish
AWAIT(worker)
ASSERT(EQ(finished, TRUE))

! Restart the finished thread
THR r = RESTART(worker)
ASSERT(EQ(TYPE(r), "THR"))
ASSERT(EQ(r, worker))
ASSERT(BOOL(r))

! After restart, the thread should run again and set finished
AWAIT(r)
ASSERT(EQ(finished, TRUE))
