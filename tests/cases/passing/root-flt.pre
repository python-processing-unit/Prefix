FLT exact_hex = 0x64.0
FLT exact_dec = 0d64.0
FLT zero_hex = 0x0.0
FLT negative_odd_dec = -0d27.0
FLT root_dec = 0d2.0
FLT root_hex = 0x3.0

ASSERT(EQ(ROOT(exact_hex, root_dec), 0xA.0))
ASSERT(ISFLT(ROOT(exact_hex, root_dec)))
ASSERT(EQ(BASE(ROOT(exact_hex, root_dec)), 0d16))

ASSERT(EQ(ROOT(exact_dec, root_hex), 0x4.0))
ASSERT(EQ(BASE(ROOT(exact_dec, root_hex)), 0d16))

ASSERT(EQ(ROOT(zero_hex, root_hex), 0x0.0))
ASSERT(EQ(BASE(ROOT(zero_hex, root_hex)), 0d16))
ASSERT(EQ(ROOT(negative_odd_dec, root_hex), -0x3.0))
ASSERT(EQ(BASE(ROOT(negative_odd_dec, root_hex)), 0d16))
