INT pos_dec = 0d3
INT neg_literal = -0d3
INT hex_val = 0xA
INT bin_val = 0b1010
INT zero = 0d0

ASSERT(EQ(NEG(pos_dec), -0d3))
ASSERT(EQ(NEG(neg_literal), 0d3))
ASSERT(EQ(NEG(NEG(pos_dec)), pos_dec))
ASSERT(EQ(NEG(zero), 0d0))
ASSERT(EQ(BASE(NEG(hex_val)), BASE(hex_val)))
ASSERT(EQ(BASE(NEG(bin_val)), BASE(bin_val)))
