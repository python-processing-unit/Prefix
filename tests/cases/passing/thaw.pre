BOOL: thaw_value = TRUE

ASSERT(NOT(THAW(thaw_value)))
ASSERT(thaw_value)

ASSERT(NOT(FREEZE(thaw_value)))
ASSERT(FROZEN(thaw_value))
ASSERT(NOT(THAW(thaw_value)))
ASSERT(NOT(FROZEN(thaw_value)))

thaw_value = FALSE
ASSERT(EQ(thaw_value, FALSE))

BOOL: thaw_undefined_failed = FALSE
TRY{
    THAW(not_declared)
} CATCH {
    thaw_undefined_failed = TRUE
}
ASSERT(thaw_undefined_failed)
