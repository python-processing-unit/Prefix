ASSERT(EQ(UNSER('\R{"t":"BOOL","v":true}'), TRUE))

STR: spaced_false = JOIN("\n  ", '\R{"t":"BOOL","v":false}', "\r\t")
ASSERT(EQ(UNSER(spaced_false), FALSE))

ASSERT(EQ(UNSER('\R{"t":"INT","v":"-0xA"}'), -0xA))
ASSERT(EQ(UNSER('\R{"t":"FLT","v":"0d3.5"}'), 0d3.5))
ASSERT(EQ(STR(UNSER('\R{"t":"FLT","v":"NaN"}')), "NaN"))
ASSERT(EQ(UNSER('\R{"t":"STR","v":"Prefix\n"}'), "Prefix\n"))
ASSERT(EQ(UNSER('\R{"t":"STR","v":"\u00E9"}'), "\u00E9"))