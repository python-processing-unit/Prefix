! Named MAP template with "match" subkey is allowed (value_map_matches ignores it)
MAP{<"x" = 0d1, "match" = <"typing" = 0d1>>} has_match
has_match = <"x" = 0d99>
ASSERT(ISMAP(has_match))
ASSERT(EQ(has_match<"x">, 0d99))

! Also verify with "shape" metadata subkey
MAP{<"a" = "hello", "match" = <"shape" = 0d1, "typing" = 0d1>>} has_shape
has_shape = <"a" = "world">
ASSERT(EQ(has_shape<"a">, "world"))

! Verify with "recurse" metadata subkey  
MAP{<"b" = 0d1, "match" = <"recurse" = 0d1, "typing" = 0d0>>} has_recurse
has_recurse = <"b" = 0d42>
ASSERT(EQ(has_recurse<"b">, 0d42))

! Verify empty "match" metadata
MAP{<"c" = 0d1, "match" = <>>} has_empty_match
has_empty_match = <"c" = 0d7>
ASSERT(EQ(has_empty_match<"c">, 0d7))

! Verify "match" key in nested template
MAP{<"nested" = <"match" = <"typing" = 0d1>, "val" = 0d1>>} has_nested_match
has_nested_match = <"nested" = <"val" = 0d5>>
ASSERT(EQ(has_nested_match<"nested", "val">, 0d5))
