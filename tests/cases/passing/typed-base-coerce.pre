FUNC INT{0d2} add(~INT{0d2} a, ~INT{0d2} b) {
    RETURN(+(a, b))
}
ASSERT(EQ(add(0d5, 0d6), 0b1011))
ASSERT(EQ(add(0xA, 0xB), 0b10101))
ASSERT(EQ(add(0o3, 0o4), 0b111))
ASSERT(EQ(BASE(add(0d1, 0d1)), 0d2))

FUNC FLT{0d16} scale(~FLT{0d16} x) {
    RETURN(*(x, 0x2.0))
}
ASSERT(EQ(scale(0d3.0), 0x6.0))
ASSERT(EQ(BASE(scale(0d1.0)), 0d16))
