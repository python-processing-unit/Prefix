STR loc = '\R{"file":"<unknown>","line":1,"column":1,"statement":""}'

STR json = JOIN( ^
    '\R{"t":"FUNC","id":"f1","name":"read_alias","return":"INT","params":[],"def":{"name":"read_alias","return":"INT","params":[],"body":{"n":"Block","loc":', ^
    loc, ^
    '\R,"statements":[{"n":"ReturnStatement","loc":', ^
    loc, ^
    '\R,"expression":{"n":"Identifier","loc":', ^
    loc, ^
    '\R,"name":"alias"}}]},"closure":{"t":"ENV","id":"e1","def":{"values":{"seed":{"t":"INT","v":"0d9"},"alias":{"t":"PTR","name":"seed","env":{"t":"ENV","id":"e1","ref":true},"value_type":"INT"}},"declared":{"seed":"INT","alias":"INT"},"frozen":[],"permafrozen":[],"parent":null}}}}' ^
)

FUNC reader = UNSER(json)
ASSERT(EQ(TYPE(reader), "FUNC"))
ASSERT(EQ(reader(), 0d9))