PRINT("Testing freezing...")
INT: f = 0d5
ASSERT(EQ(FROZEN(f), 0d0))
ASSERT(EQ(PERMAFROZEN(f), 0d0))
FREEZE(f)
ASSERT(EQ(FROZEN(f), 0d1))
TRY{
    f = 0d2
    ASSERT(0d0)
}CATCH(SYMBOL: e){
    ASSERT(EQ(f, 0d5))
}
TRY{
    DEL(f)
    ASSERT(0d0)
}CATCH{}
THAW(f)
f = 0d2
ASSERT(EQ(f, 0d2))
PERMAFREEZE(f)
ASSERT(EQ(FROZEN(f), -0d1))
ASSERT(EQ(PERMAFROZEN(f), 0d1))
TRY{
    THAW(f)
    ASSERT(0d0)
}CATCH(SYMBOL: e){
    ASSERT(EQ(f, 0d2))
}
TRY{
    DEL(f)
    ASSERT(0d0)
}CATCH{}

TRY{
    FREEZE(nonexistent_sym)
    ASSERT(0d0)
}CATCH{}
PRINT("Freezing: PASS\n")

