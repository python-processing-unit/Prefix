PRINT("Testing BYTES...")
ASSERT(EQ(BYTES(0b0), [0b0]))
ASSERT(EQ(BYTES(0b1), [0b1]))
ASSERT(EQ(BYTES(0b100000000), BYTES(0b100000000, "big")))
ASSERT(EQ(BYTES(0b100000000), [0b1,0b0]))
ASSERT(EQ(BYTES(0b100000000, "little"), [0b0,0b1]))
PRINT("BYTES: PASS\n")

! --- Type checking ---
PRINT("Testing type checks...")
INT: i1 = 0d5
FLT: f1 = 0b1.1
STR: s1 = "test"
ASSERT(ISINT(i1))
ASSERT(NOT(ISINT(f1)))
ASSERT(ISFLT(f1))
ASSERT(NOT(ISFLT(i1)))
ASSERT(ISSTR(s1))
ASSERT(NOT(ISSTR(i1)))
ASSERT(EQ(TYPE(i1), "INT"))
ASSERT(EQ(TYPE(f1), "FLT"))
