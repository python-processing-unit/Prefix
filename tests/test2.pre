PRINT("Testing type conversions...")
ASSERT(EQ(INT(0b0.1), 0b0))           ! FLT->INT truncates
ASSERT(EQ(FLT(0b10), 0b10.0))         ! INT->FLT
ASSERT(EQ(STR(0b101), "0b101"))       ! INT->STR
ASSERT(EQ(INT("0b101"), 0b101))       ! STR->INT
PRINT("Type conversions: PASS\n")

